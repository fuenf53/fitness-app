# Copy to .env to enable cross-device sync. Without these the app runs
# entirely on localStorage — every feature still works, data just stays
# on the device it was entered on.
# Put REAL values in .env, never here — this file is the committed template.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base URL of a self-hosted ExerciseDB instance. Leave empty to
# use the bundled catalogue in src/features/exercises/exerciseData.js
VITE_EXERCISE_API=
